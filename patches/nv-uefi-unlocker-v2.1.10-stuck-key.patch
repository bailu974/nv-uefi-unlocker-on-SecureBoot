+/// Stuck-key workaround (same class as issue #110, different key): some
+/// laptop ECs synthesise a Ctrl+C (0x03) during firmware boot and keep
+/// re-sending it every poll. A real Ctrl+C means "stop", but a phantom one
+/// makes the tool unusable on that machine, so this build ignores 0x03 in
+/// every abort window. Space/Enter still confirm and every other key still
+/// aborts - the safety semantics are unchanged for real input.
+pub fn is_ignored_stuck_key(key: &Key) -> bool {
+    matches!(key, Key::Printable(c) if u16::from(*c) == 0x03)
+}
